#!/usr/bin/env python3
"""Docker health check: the web interface answers on its local port."""
import sys
import urllib.request

try:
    with urllib.request.urlopen("http://127.0.0.1:8099/api/queue", timeout=5) as response:
        sys.exit(0 if response.status == 200 else 1)
except OSError:
    sys.exit(1)
